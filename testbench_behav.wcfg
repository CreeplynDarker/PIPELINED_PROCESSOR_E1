      <obj_property name="ObjectShortName">RdW[4:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/testbench/dut/rvp/dp/ResultW" type="array">
      <obj_property name="ElementShortName">ResultW[31:0]</obj_property>
      <obj_property name="ObjectShortName">ResultW[31:0]</obj_property>
   </wvobject>
